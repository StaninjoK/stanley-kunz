---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { TOPICS, TOPIC_IDS, topicPath } from '../../config/taxonomy';
import { topicCounts } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { ICON } from '../../lib/icons';

const counts = new Map((await topicCounts()).map((c) => [c.id, c.count]));
const topics = TOPIC_IDS.filter((t) => (counts.get(t) ?? 0) > 0).sort((a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0));
---

<BaseLayout
  title="Themen"
  description="Alle Themen auf einen Blick: Uruguay, Auswandern, Unternehmertum, Landwirtschaft, Agrardrohnen und mehr – mit allen Videos, Stories und Momenten."
  path="/themen/"
  ogImage="/og/pages/themen.jpg"
  schema={[breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Themen', path: '/themen/' }])]}
>
  <PageHeader eyebrow="Themen" title="Worum es <em>hier geht.</em>" intro="Ein kleines, festes Set an Themen. Jedes Video, jede Story und jeder Moment gehört zu einem oder mehreren davon." />
  <div class="container wrap">
    <ul role="list" class="list">
      {
        topics.map((t, i) => (
          <li data-reveal style={`--reveal-delay: ${i % 4}`}>
            <a href={topicPath(t)} class="row">
              <span class="name">{TOPICS[t].label}</span>
              <span class="desc">{TOPICS[t].description}</span>
              <span class="count">{counts.get(t)} Beiträge</span>
              <span class="go" set:html={ICON.arrow} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-bottom: var(--section);
  }
  .list {
    border-top: 1px solid var(--rule-strong);
  }
  .list li {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name go' 'desc go' 'count go';
    gap: 0.3rem 1rem;
    align-items: center;
    padding: 1.4rem 0;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 18rem minmax(0, 1fr) 8rem 44px;
      grid-template-areas: 'name desc count go';
      gap: 2rem;
    }
  }
  .name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1.1;
  }
  .desc {
    grid-area: desc;
    color: var(--text-soft);
  }
  .count {
    grid-area: count;
    font-size: 0.85rem;
    color: var(--text-mute);
  }
  .go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
  }
  .go :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .row:hover .name {
    font-style: italic;
  }
  .row:hover .go {
    background: var(--sun);
    border-color: var(--sun);
  }
</style>
