---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import VideoCard from '../../components/cards/VideoCard.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import TopicFilter from '../../components/TopicFilter.astro';
import { getVideos, isPublishedVideo, storyForVideo, storyUrl, videoUrl, youtubeFeed } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../config/site';
import { ICON, BRAND_ICON } from '../../lib/icons';
import type { TopicId } from '../../config/taxonomy';

const videos = await getVideos();
const [lead, ...rest] = videos;
const leadStory = lead ? await storyForVideo(lead.id) : undefined;
const topics = [...new Set(videos.flatMap((v) => v.data.topics))] as TopicId[];
// Shorts and any upload that has no curated entry yet come straight from the YouTube feed (synced every few hours).
const known = new Set(videos.map((v) => v.data.youtubeId).filter(Boolean));
const shorts = youtubeFeed().filter((v) => v.isShort && !known.has(v.id)).slice(0, 12);
---

<BaseLayout
  title="Videos"
  description="Alle Videos von Stanley Kunz: Auswandern nach Uruguay, Alltag auf dem Campo, Agrardrohnen und Unternehmertum – mit Kapiteln und den passenden Stories."
  path="/videos/"
  ogImage="/og/pages/videos.jpg"
  schema={[breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Videos', path: '/videos/' }])]}
>
  <PageHeader
    eyebrow="Videos"
    title="Gefilmt, <em>während es passiert.</em>"
    intro="Meine längeren Videos laufen auf YouTube. Hier findest du sie mit Kapiteln, kurzer Einordnung und – wenn es eine gibt – der Story zum Nachlesen."
  >
    <a class="btn btn-sun yt" href={SITE.youtube.subscribeUrl} rel="noopener" target="_blank" data-track="outbound-youtube-videos">
      <span set:html={BRAND_ICON.youtube} /> Kanal abonnieren
    </a>
  </PageHeader>

  <div class="container listing">
    {
      lead && (
        <section class="lead" aria-labelledby="lead-title" data-reveal>
          <VideoFacade video={lead} sizes="(min-width: 1100px) 860px, 100vw" priority />
          <div class="lead-text">
            <p class="eyebrow">{isPublishedVideo(lead) ? 'Neuestes Video' : 'Demnächst'}</p>
            <h2 id="lead-title" class="lead-title">
              <a href={videoUrl(lead)}>{lead.data.title}</a>
            </h2>
            <p class="lead-desc">{lead.data.description}</p>
            <div class="lead-links">
              <a class="link-arrow" href={videoUrl(lead)}>
                Kapitel & Details <span set:html={ICON.arrow} />
              </a>
              {leadStory && (
                <a class="link-arrow" href={storyUrl(leadStory)}>
                  Die Story dazu <span set:html={ICON.arrow} />
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="all" aria-labelledby="all-title">
          <h2 id="all-title" class="sec-title">Alle Videos</h2>
          {topics.length > 1 && <TopicFilter topics={topics} target="#video-list" empty="#video-empty" />}
          <div id="video-list" class="grid">
            {rest.map((v, i) => (
              <div data-reveal style={`--reveal-delay: ${i % 3}`} data-topics={v.data.topics.join(' ')}>
                <VideoCard video={v} headingLevel={3} />
              </div>
            ))}
          </div>
          <p id="video-empty" class="empty" hidden>
            Zu diesem Thema gibt es noch kein weiteres Video.
          </p>
        </section>
      )
    }

    {
      shorts.length > 0 && (
        <section class="shorts" aria-labelledby="shorts-title">
          <h2 id="shorts-title" class="sec-title">Shorts</h2>
          <ul role="list" class="shorts-grid">
            {shorts.map((s) => (
              <li>
                <a href={`https://www.youtube.com/shorts/${s.id}`} rel="noopener" target="_blank" data-track="outbound-youtube-short">
                  <span class="frame ratio-916 short-thumb">
                    <img src={`/media/yt/${s.id}.jpg`} alt="" loading="lazy" decoding="async" width="270" height="480" />
                  </span>
                  <span class="short-t">{s.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .yt {
    margin-top: 2rem;
  }
  .yt :global(svg) {
    width: 1.25em;
    height: 1.25em;
  }
  .listing {
    padding-bottom: var(--section);
  }
  .lead {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 1000px) {
    .lead {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .lead-title {
    margin-top: 1rem;
    font-size: var(--fs-h2);
  }
  .lead-title a {
    text-decoration: none;
  }
  .lead-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sun);
  }
  .lead-desc {
    margin-top: 1rem;
    color: var(--text-soft);
  }
  .lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .sec-title {
    font-size: var(--fs-h3);
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) 0 1.75rem;
  }
  .grid {
    display: grid;
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .grid > [hidden] {
    display: none;
  }
  .empty {
    color: var(--text-mute);
  }
  .shorts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
  }
  .shorts-grid a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }
  .short-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .short-t {
    font-size: 0.92rem;
    font-weight: 550;
    line-height: 1.3;
  }
</style>
