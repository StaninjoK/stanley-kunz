---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Props {
  src: ImageMetadata | Promise<{ default: ImageMetadata }>;
  alt: string;
  caption?: string;
  /** wide: breaks out of the text column. portrait: narrower, centred. */
  ratio?: 'wide' | 'portrait' | 'natural';
  position?: string;
}
const { src, alt, caption, ratio = 'natural', position } = Astro.props;
const img = 'then' in src ? (await src).default : src;
const sizes = ratio === 'wide' ? '(min-width: 1200px) 1100px, 100vw' : ratio === 'portrait' ? '(min-width: 700px) 420px, 88vw' : '(min-width: 800px) 720px, 100vw';
---

<figure class:list={['figure', `r-${ratio}`]} data-reveal>
  <div class="frame">
    <Media src={img} alt={alt} sizes={sizes} position={position} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }
  .r-wide {
    /* Break out of the text column symmetrically, without creating horizontal overflow. */
    --w: min(1100px, calc(100vw - 2 * var(--gutter)));
    width: var(--w);
    margin-inline: calc((100% - var(--w)) / 2);
  }
  /* Story pages have a sticky side rail from 1100px on: stay inside the text column there. */
  @media (min-width: 1100px) {
    :global(.layout) .r-wide {
      --w: 100%;
    }
  }
  .r-wide .frame {
    aspect-ratio: 16 / 9;
  }
  .r-portrait {
    max-width: 420px;
    margin-inline: auto;
  }
  .r-portrait .frame {
    aspect-ratio: 4 / 5;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: 0.8rem;
    font-family: var(--font-text);
    font-size: var(--fs-small);
    color: var(--text-mute);
    line-height: 1.45;
  }
  .r-wide figcaption {
    max-width: var(--max-text);
  }
</style>
