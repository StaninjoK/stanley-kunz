---
import { SITE, visibleSocial } from '../config/site';
import { ICON } from '../lib/icons';
import { BUILD_TIME, getProjects } from '../lib/content';

const social = visibleSocial();
const projects = (await getProjects()).filter((p) => p.data.featured);
const year = BUILD_TIME.getFullYear();
---

<footer class="site-footer surface-night grain">
  <div class="container">
    <div class="top">
      <div class="claim">
        <p class="name">Stanley Kunz</p>
        <p class="line">Unternehmer in Uruguay. Rindfleisch und Merinowolle für Europa, dazu Software und Agrardrohnen für die Landwirtschaft.</p>
        <a class="btn btn-sun" href={`mailto:${SITE.author.email}`} data-track="contact-mail-footer">
          <span set:html={ICON.mail} />
          Anfrage senden
        </a>
      </div>

      <nav class="cols" aria-label="Fußzeile">
        <div>
          <p class="col-title">Unternehmen</p>
          <ul role="list">
            {
              projects.map((p) => (
                <li>
                  <a href={`/projekte/#${p.id}`}>{p.data.name}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="col-title">Über mich</p>
          <ul role="list">
            <li><a href="/ueber-mich/">Profil</a></li>
            <li><a href="/projekte/">Alle Unternehmen</a></li>
            <li><a href={SITE.organization.url} rel="noopener">Kunz Global <span class="ext" set:html={ICON.arrowUpRight} /></a></li>
          </ul>
        </div>
        <div>
          <p class="col-title">Kontakt</p>
          <ul role="list">
            <li><a href={`mailto:${SITE.author.email}`}>E-Mail</a></li>
            {
              social.map((s) => (
                <li>
                  <a href={s.url} rel="noopener me" target="_blank" data-track={`outbound-${s.id}-footer`}>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} Stanley Kunz · Uruguay</p>
      <ul role="list">
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
        <li><a href={`mailto:${SITE.author.email}`}>{SITE.author.email}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(4rem, 2.5rem + 6vw, 7rem) 2rem;
  }
  .top {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 960px) {
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.5rem + 5.5vw, 6rem);
    font-weight: 430;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .line {
    margin-top: 1.1rem;
    max-width: 30rem;
    color: var(--on-night-soft);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }
  .claim .btn {
    margin-top: 2rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.2rem 1.5rem;
  }
  @media (min-width: 600px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .col-title {
    font-size: var(--fs-meta);
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--on-night-mute);
    margin-bottom: 0.9rem;
  }
  .cols ul {
    display: grid;
    gap: 0.15rem;
  }
  .cols a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 36px;
    text-decoration: none;
    color: var(--on-night);
    opacity: 0.86;
    transition: opacity var(--t-fast), color var(--t-fast);
  }
  .cols a:hover {
    opacity: 1;
    color: var(--sun);
  }
  .ext :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
  .bottom {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-night);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    font-size: var(--fs-small);
    color: var(--on-night-mute);
  }
  .bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .bottom a {
    color: var(--on-night-soft);
    text-decoration: none;
  }
  .bottom a:hover {
    color: var(--on-night);
    text-decoration: underline;
  }
  .btn :global(svg) {
    width: 1.2em;
    height: 1.2em;
  }
</style>
