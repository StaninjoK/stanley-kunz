---
import { SITE, visibleSocial } from '../config/site';
import { ICON, BRAND_ICON } from '../lib/icons';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;

const NAV = [
  { href: '/videos/', label: 'Videos' },
  { href: '/stories/', label: 'Stories' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/ueber-mich/', label: 'Über mich' },
];
const MORE = [
  { href: '/weg/', label: 'Der Weg' },
  { href: '/momente/', label: 'Momente' },
  { href: '/themen/', label: 'Themen' },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const social = visibleSocial();
---

<header class="site-header" data-header data-overlay={overlay ? 'true' : 'false'}>
  <div class="bar container">
    <a class="brand" href="/" aria-label={`${SITE.name} – Startseite`}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-name">Stanley Kunz</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="yt" href={SITE.youtube.channelUrl} rel="noopener" target="_blank" data-track="outbound-youtube-header" aria-label="YouTube-Kanal von Stanley Kunz">
        <span class="yt-icon" set:html={BRAND_ICON.youtube} />
        <span class="yt-label">YouTube</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span set:html={ICON.menu} />
        <span class="visually-hidden">Menü öffnen</span>
      </button>
    </div>
  </div>

  <div class="menu surface-night grain" id="site-menu" hidden data-menu>
    <div class="menu-inner container">
      <div class="menu-top">
        <span class="brand-name">Stanley Kunz</span>
        <button class="menu-close" type="button" data-menu-close>
          <span set:html={ICON.close} />
          <span class="visually-hidden">Menü schließen</span>
        </button>
      </div>
      <nav aria-label="Menü">
        <ul role="list" class="menu-list">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Start</a></li>
          {
            [...NAV, ...MORE].map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul role="list" class="menu-social">
        {
          social.map((s) => (
            <li>
              <a href={s.url} rel="noopener me" target="_blank" data-track={`outbound-${s.id}-menu`}>
                <span set:html={BRAND_ICON[s.id]} />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--text);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--rule);
    transition:
      background-color var(--t-med),
      color var(--t-med),
      border-color var(--t-med),
      transform var(--t-med) var(--ease-out);
  }
  .site-header[data-overlay='true'] {
    position: fixed;
    inset: 0 0 auto 0;
  }
  .site-header[data-overlay='true']:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
    color: var(--on-night);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-dot {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sun) 22%, transparent);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 540;
    font-size: 1.32rem;
    letter-spacing: -0.02em;
  }
  .nav ul {
    display: flex;
    gap: 0.3rem;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    font-weight: 550;
    font-size: 0.96rem;
    text-decoration: none;
    opacity: 0.86;
    transition: opacity var(--t-fast);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    opacity: 1;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.55rem;
    height: 2px;
    background: var(--sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-med) var(--ease-out);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .yt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 0.95rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color var(--t-fast), border-color var(--t-fast), color var(--t-fast);
  }
  .yt:hover {
    background: var(--sun);
    border-color: var(--sun);
    color: var(--night);
  }
  .yt-icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .menu-btn,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }
  .menu-btn :global(svg),
  .menu-close :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  @media (min-width: 900px) {
    .menu-btn {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .nav {
      display: none;
    }
    .yt-label {
      display: none;
    }
    .yt {
      padding: 0;
      width: 44px;
      justify-content: center;
      border: 0;
    }
  }

  /* full-screen mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 2.5rem;
  }
  .menu-top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-list {
    margin-top: 2rem;
    display: grid;
    gap: 0.2rem;
  }
  .menu-list a {
    display: block;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.4rem + 4vw, 3.2rem);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-decoration: none;
  }
  .menu-list a[aria-current='page'] {
    font-style: italic;
    color: var(--sun);
  }
  .menu-social {
    margin-top: auto;
    padding-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .menu-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule-night-strong);
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
  }
  .menu-social :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu-list li {
      animation: menu-in 0.6s var(--ease-out) both;
    }
    .menu-list li:nth-child(2) { animation-delay: 40ms; }
    .menu-list li:nth-child(3) { animation-delay: 80ms; }
    .menu-list li:nth-child(4) { animation-delay: 120ms; }
    .menu-list li:nth-child(5) { animation-delay: 160ms; }
    .menu-list li:nth-child(6) { animation-delay: 200ms; }
    .menu-list li:nth-child(7) { animation-delay: 240ms; }
    .menu-list li:nth-child(8) { animation-delay: 280ms; }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
