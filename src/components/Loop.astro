---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

/**
 * Ambient, muted video loop with a real poster image underneath.
 * The video file is only requested once the loop scrolls into view (see scripts/site.ts),
 * never with prefers-reduced-motion or Save-Data – then the poster simply stays.
 */
interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}
const { src, poster, alt, sizes, priority = false, class: className } = Astro.props;
---

<div class:list={['loop', className]}>
  <Media src={poster} alt={alt} sizes={sizes} priority={priority} widths={[360, 540, 720]} />
  <!-- No poster attribute: the <picture> underneath already is the poster (avoids a second download). -->
  <video data-loop muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
    <source data-src={src} type="video/mp4" />
  </video>
</div>

<style>
  .loop {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .loop :global(img),
  .loop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .loop video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .loop video:global(.is-playing) {
    opacity: 1;
  }
</style>
